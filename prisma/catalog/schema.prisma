// Schema do banco "catalog" — separado do schema de tenant (prisma/schema.prisma).
// Guarda os metadados de todas as empresas cadastradas e o(s) usuário(s) master
// do sistema. Não guarda nenhum dado operacional de empresa (isso vive no
// banco de cada tenant, um por empresa).
//
// Por padrão aponta pra CATALOG_DATABASE_URL; se não definida, cai no mesmo
// DATABASE_URL do banco atual (útil enquanto só existe uma database — quando
// as empresas forem provisionadas em databases próprias, basta apontar
// CATALOG_DATABASE_URL pra uma database dedicada no mesmo servidor Postgres).
//
// Como no schema de tenant, os `@default(...)`, `@db.Timestamptz(6)` e `map:`
// espelham o que os bancos criados antes das migrations já têm — ver a nota
// em prisma/schema.prisma.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  output        = "../../node_modules/.prisma/catalog-client"
}

datasource db {
  provider = "postgresql"
  url      = env("CATALOG_DATABASE_URL")
}

model Empresa {
  id          Int      @id @default(autoincrement())
  cnpjRuc     String   @unique @map("cnpj_ruc") // normalizado: só dígitos
  nome        String   @default("")
  dbName      String   @unique @map("db_name") // nome da database do tenant, ex: empresa_12345678000199
  status      String   @default("pendente") // pendente | ativa | suspensa
  emailMaster String   @default("") @map("email_master") // e-mail do admin da empresa, recebe o convite
  maxUsers    Int      @default(5) @map("max_users") // limite de licenças (usuários ativos + convites pendentes)
  /// Moeda em que a empresa lê os próprios números: "1" R$, "2" US$, "3" G$.
  ///
  /// É o destino da conversão quando o filtro está em "Todas as moedas". Antes
  /// o destino era R$ fixo no código, o que dava um painel em reais para uma
  /// empresa paraguaia cujo movimento é 99,9% guarani.
  ///
  /// Também é o PIVÔ da tabela de câmbio: as cotações são guardadas contra ela,
  /// e os demais sentidos saem por derivação — ver `cambio` no schema do tenant.
  moedaPadrao String   @default("1") @map("moeda_padrao")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inviteTokens      InviteToken[]
  integrationTokens IntegrationToken[]

  @@map("empresas")
}

// Conta SMTP ÚNICA do sistema — é dela que saem todos os e-mails (convites de
// empresa, convites de usuário, testes), independente de qual empresa originou
// a ação. Vive no catalog, não no banco de cada tenant, justamente porque não é
// configuração de empresa: só o master edita.
//
// A tabela se chama `system_smtp_config` e não `smtp_config` de propósito: por
// padrão CATALOG_DATABASE_URL cai na mesma database do tenant, onde já existe
// uma `smtp_config` do schema de tenant — nomes iguais colidiriam na mesma
// database. A `smtp_config` do tenant virou legado a partir daqui.
model SystemSmtpConfig {
  id          Int      @id @default(1)
  host        String   @default("")
  port        Int      @default(587)
  secure      Boolean  @default(false)
  user        String   @default("")
  passwordEnc String   @default("") @map("password_enc")
  fromName    String   @default("MGSIS Analytics") @map("from_name")
  fromEmail   String   @default("") @map("from_email")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_smtp_config")
}

model MasterUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @default("") @map("password_hash")
  name         String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("master_users")
}

model InviteToken {
  id        Int       @id @default(autoincrement())
  empresaId Int       @map("empresa_id")
  tokenHash String    @unique @map("token_hash") // nunca guardar o token em texto puro
  email     String    @default("")
  role      String    @default("admin") // papel do usuário criado na ativação: "admin" | "user"
  /// Quem pediu o link — e, por consequência, o que ele tem permissão de fazer:
  ///
  /// "invite"     um admin/master gerou (convite de empresa, convite de usuário
  ///              ou POST /api/users/[id]/reset-link). Cria a conta se ainda não
  ///              existir, DESTRAVA a que estava inativa e marca a empresa como
  ///              ativa.
  /// "self_reset" o próprio usuário pediu em "Esqueci minha senha". Só troca a
  ///              senha de uma conta que já existe e já está ativa: nunca cria
  ///              usuário, nunca destrava conta bloqueada e nunca mexe no status
  ///              da empresa. É o que mantém de pé a regra das 3 tentativas —
  ///              quem foi bloqueado continua dependendo do gestor.
  kind      String    @default("invite")
  // O default NOW() aqui é herança do SQL legado e não tem uso prático (todo
  // convite passa expiresAt explícito); está no datamodel só pra refletir o banco.
  expiresAt DateTime  @default(now()) @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresaId], map: "idx_invite_tokens_empresa")
  @@map("invite_tokens")
}

model IntegrationToken {
  id         Int       @id @default(autoincrement())
  empresaId  Int       @map("empresa_id")
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([empresaId], map: "idx_integration_tokens_empresa")
  @@map("integration_tokens")
}
