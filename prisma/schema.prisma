generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTA (fase 7 — migrations versionadas):
// Os `@default(...)`, `@db.Timestamptz(6)` e `map:` deste arquivo descrevem o que
// os bancos criados antes das migrations realmente têm (o SQL idempotente que
// ainda vive em src/lib/server/db.ts). Isso é proposital: com o datamodel igual
// ao banco legado, adotar um tenant existente é só `prisma migrate resolve
// --applied` — nenhum ALTER TABLE roda em produção. Confira com
// `npm run migrate:check -- <url>` antes de mudar qualquer coisa aqui.

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String   @default("") @map("password_hash")
  name         String   @default("")
  role         String   @default("admin") // "admin" | "user"
  isActive     Boolean  @default(true) @map("is_active")
  failedLoginAttempts Int @default(0) @map("failed_login_attempts") // zera a cada login OK; 3 erradas seguidas inativa a conta
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  menuAccess MenuPermission[]

  @@map("users")
}

// Allow-list de menus por usuário: presença de linha = enxerga aquele menu.
// Só vale pra role "user" — "admin" sempre vê tudo (ver seção 5.1 do plano).
model MenuPermission {
  id      Int    @id @default(autoincrement())
  userId  Int    @map("user_id")
  menuKey String @map("menu_key") // mesma chave usada em src/lib/menu-catalog.ts (o href da página)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, menuKey])
  @@index([userId], map: "idx_menu_permissions_user")
  @@map("menu_permissions")
}

// Conta SMTP única usada para disparo de e-mails do sistema (convites, notificações).
// Linha única (id fixo = 1) preenchida pelo master nas Configurações.
model SmtpConfig {
  id          Int      @id @default(1)
  host        String   @default("")
  port        Int      @default(587)
  secure      Boolean  @default(false)
  user        String   @default("")
  passwordEnc String   @default("") @map("password_enc")
  fromName    String   @default("MGSIS Analytics") @map("from_name")
  fromEmail   String   @default("") @map("from_email")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("smtp_config")
}

model DatasetMeta {
  kind       String @id
  filename   String @default("")
  rowCount   Int    @default(0) @map("row_count")
  importedAt String @default("") @map("imported_at")

  @@map("dataset_meta")
}

// Importação de arquivo em andamento (fase E).
//
// O arquivo de vendas do cliente tem ~245 MB e 1,4 milhão de linhas: não cabe
// numa requisição síncrona (timeout de proxy) nem na RAM do VPS se for lido de
// uma vez. O upload responde na hora criando um job, e o processamento roda em
// segundo plano lendo o CSV em streaming — é o que faz a importação parar de
// depender da aba ficar aberta.
//
// `lidas` avança durante o parse e `gravadas` durante a inserção; a tela usa os
// dois para mostrar progresso. O total de linhas só é conhecido no fim (não dá
// para saber quantas um CSV tem sem lê-lo), então até lá a barra é indeterminada.
model ImportJob {
  id        String  @id
  /// DatasetKind do csv-parser: sales, receivable, payable, inventory, caixa, orcamento.
  kind      String  @default("")
  filename  String  @default("")
  bytes     Int     @default(0)
  /// recebido | processando | concluido | erro
  status    String  @default("recebido")
  lidas     Int     @default(0)
  gravadas  Int     @default(0)
  ignoradas Int     @default(0)
  /// Mensagem de falha, quando status = erro.
  erro      String  @default("")
  /// Avisos do parser, serializados em JSON.
  avisos    String  @default("[]")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")
  concluidoEm  DateTime? @map("concluido_em")

  @@index([criadoEm], map: "idx_import_jobs_criado")
  @@map("import_jobs")
}

model SaleItem {
  id           Int    @id @default(autoincrement())
  date         String @default("")
  orderId      String @default("") @map("order_id")
  orderType    String @default("VENDA") @map("order_type")
  channel      String @default("")
  clientId     String @default("") @map("client_id")
  clientName   String @default("") @map("client_name")
  clientCity   String @default("") @map("client_city")
  productId    String @default("") @map("product_id")
  productName  String @default("") @map("product_name")
  quantity     Float  @default(0)
  totalOrig    Float  @default(0) @map("total_orig")
  costOrig     Float  @default(0) @map("cost_orig")
  discountOrig Float  @default(0) @map("discount_orig")
  subgroupId   String @default("") @map("subgroup_id")
  subgroupName String @default("") @map("subgroup_name")
  sellerId     String @default("") @map("seller_id")
  sellerName   String @default("") @map("seller_name")
  currencyId   String @default("1") @map("currency_id")
  currencyCode String @default("R$") @map("currency_code")
  empresaId    String @default("") @map("empresa_id")

  @@index([date], map: "idx_sale_items_date")
  @@index([clientId], map: "idx_sale_items_client_id")
  @@index([productId], map: "idx_sale_items_product_id")
  @@index([sellerId], map: "idx_sale_items_seller_id")
  @@index([empresaId], map: "idx_sale_items_empresa_id")
  @@map("sale_items")
}

model ReceivableItem {
  id           Int     @id @default(autoincrement())
  documentId   String  @default("") @map("document_id")
  clientId     String  @default("") @map("client_id")
  clientName   String  @default("") @map("client_name")
  clientCity   String  @default("") @map("client_city")
  issueDate    String  @default("") @map("issue_date")
  dueDate      String  @default("") @map("due_date")
  receivedDate String  @default("") @map("received_date")
  isPaid       Boolean @default(false) @map("is_paid")
  entryType    String  @default("") @map("entry_type")
  amountOrig   Float   @default(0) @map("amount_orig")
  sellerId     String  @default("") @map("seller_id")
  sellerName   String  @default("") @map("seller_name")
  currencyId   String  @default("1") @map("currency_id")
  currencyCode String  @default("R$") @map("currency_code")
  empresaId    String  @default("") @map("empresa_id")

  @@index([dueDate], map: "idx_receivable_due_date")
  @@index([clientId], map: "idx_receivable_client_id")
  @@index([isPaid], map: "idx_receivable_is_paid")
  @@index([empresaId], map: "idx_receivable_empresa")
  @@map("receivable_items")
}

model PayableItem {
  id           Int     @id @default(autoincrement())
  documentId   String  @default("") @map("document_id")
  supplierId   String  @default("") @map("supplier_id")
  supplierName String  @default("") @map("supplier_name")
  issueDate    String  @default("") @map("issue_date")
  dueDate      String  @default("") @map("due_date")
  paidDate     String  @default("") @map("paid_date")
  isPaid       Boolean @default(false) @map("is_paid")
  entryType    String  @default("") @map("entry_type")
  amountOrig   Float   @default(0) @map("amount_orig")
  currencyId   String  @default("1") @map("currency_id")
  currencyCode String  @default("R$") @map("currency_code")
  empresaId    String  @default("") @map("empresa_id")

  @@index([dueDate], map: "idx_payable_due_date")
  @@index([supplierId], map: "idx_payable_supplier")
  @@index([isPaid], map: "idx_payable_is_paid")
  @@index([empresaId], map: "idx_payable_empresa")
  @@map("payable_items")
}

model InventoryItem {
  id               Int    @id @default(autoincrement())
  productId        String @default("") @map("product_id")
  description      String @default("")
  manufacturerCode String @default("") @map("manufacturer_code")
  stock            Float  @default(0)
  costTotalUSD     Float  @default(0) @map("cost_total_usd")
  minStock         Float  @default(0) @map("min_stock")
  currencyId       String @default("1") @map("currency_id")
  currencyCode     String @default("R$") @map("currency_code")
  empresaId        String @default("") @map("empresa_id")

  @@index([productId], map: "idx_inventory_product_id")
  @@index([empresaId], map: "idx_inventory_empresa")
  @@map("inventory_items")
}

model CaixaItem {
  id                   Int    @id @default(autoincrement())
  date                 String @default("")
  centroCustoId        String @default("") @map("centro_custo_id")
  centroCustoDescricao String @default("") @map("centro_custo_descricao")
  planoContaId         String @default("") @map("plano_conta_id")
  planoContaCodigo     String @default("") @map("plano_conta_codigo")
  planoContaDescricao  String @default("") @map("plano_conta_descricao")
  caixaId              String @default("") @map("caixa_id")
  caixaDescricao       String @default("") @map("caixa_descricao")
  valorDocumento       Float  @default(0) @map("valor_documento")
  moedaId              String @default("1") @map("moeda_id")
  moedaSigla           String @default("R$") @map("moeda_sigla")
  empresaId            String @default("") @map("empresa_id")

  @@index([date], map: "idx_caixa_date")
  @@index([planoContaCodigo], map: "idx_caixa_plano")
  @@index([empresaId], map: "idx_caixa_empresa")
  @@map("caixa_items")
}

// Orçamentos — tabela flat, uma linha por item (igual ao leiaute de importação).
// Nomes de cliente/vendedor/produto já vêm embutidos, sem depender de tabelas do ERP.
model OrcamentoItem {
  id                       Int     @id @default(autoincrement())
  orcamentoId              String  @default("") @map("orcamento_id")
  orcamentoData            String  @default("") @map("orcamento_data")
  orcamentoConfirmado      Boolean @default(false) @map("orcamento_confirmado")
  orcamentoDataConfirmacao String  @default("") @map("orcamento_data_confirmacao")
  clienteId                String  @default("") @map("cliente_id")
  clienteNome              String  @default("") @map("cliente_nome")
  vendedorId               String  @default("") @map("vendedor_id")
  vendedorNome             String  @default("") @map("vendedor_nome")
  empresaId                String  @default("") @map("empresa_id")
  moedaId                  String  @default("1") @map("moeda_id")
  moedaSigla               String  @default("R$") @map("moeda_sigla")
  itemOrcamentoId          String  @default("") @map("item_orcamento_id")
  produtoId                String  @default("") @map("produto_id")
  produtoDescricao         String  @default("") @map("produto_descricao")
  produtoFabricante        String  @default("") @map("produto_fabricante")
  itemQuantidade           Float   @default(0) @map("item_quantidade")
  itemQuantidadeConfirmada Float   @default(0) @map("item_quantidade_confirmada")
  itemTotal                Float   @default(0) @map("item_total")

  @@index([orcamentoData], map: "idx_orcamento_data")
  @@index([empresaId], map: "idx_orcamento_empresa")
  @@index([vendedorId], map: "idx_orcamento_vendedor")
  @@map("orcamento_items")
}
