# ─── Aplicação ────────────────────────────────────────────────
# Variáveis públicas (inlined no build do Next.js). Opcionais — têm defaults.
NEXT_PUBLIC_APP_NAME="Dash BI"
NEXT_PUBLIC_DEFAULT_CURRENCY="BRL"

# ─── Banco de dados (PostgreSQL / Prisma) ─────────────────────
# Connection string do seu Postgres. As tabelas são criadas automaticamente na
# primeira conexão (CREATE TABLE IF NOT EXISTS).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@seu-host:5432/dashbi?schema=public"

# ─── Autenticação (JWT) ───────────────────────────────────────
# Segredo usado para assinar os tokens de sessão. Gere com:
#   openssl rand -base64 32
# Se não definido, cai num fallback derivado do DATABASE_URL (inseguro em prod).
AUTH_SECRET="troque-por-um-segredo-forte-de-32+-caracteres"
