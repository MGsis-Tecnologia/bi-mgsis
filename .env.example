# ─── Aplicação ────────────────────────────────────────────────
# Variáveis públicas (inlined no build do Next.js). Opcionais — têm defaults.
NEXT_PUBLIC_APP_NAME="Dash BI"
NEXT_PUBLIC_DEFAULT_CURRENCY="BRL"

# URL pública do app, usada pra montar os links de e-mail (convite de empresa/
# usuário, redefinição de senha). Atrás de proxy reverso (Coolify/Traefik) o
# Host que chega dentro do container é o endereço interno (ex: 0.0.0.0:3000),
# não o domínio público — sem isso os links de e-mail saem quebrados.
# Obrigatória em produção; opcional em dev local (cai na URL da própria requisição).
APP_URL="https://bi.seudominio.com"

# ─── Banco de dados (PostgreSQL / Prisma) ─────────────────────
# Connection string do seu Postgres. O schema é aplicado por migrations
# versionadas (prisma/migrations), rodadas no boot do container ou à mão com
# `npm run migrate:all`.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://usuario:senha@seu-host:5432/dashbi?schema=public"

# ─── Banco "catalog" (multi-empresa) ──────────────────────────
# Guarda os metadados de todas as empresas cadastradas (Empresa, MasterUser,
# tokens de convite/integração) — separado dos dados operacionais de cada tenant.
# Opcional: se não definida, usa a mesma DATABASE_URL acima (tudo num banco só,
# válido enquanto só existe uma empresa/tenant). Quando as empresas passarem a
# ter database própria, aponte isso pra uma database dedicada no mesmo servidor.
# Compartilhar a database com o tenant é suportado: as migrations de catalog e
# de tenant têm nomes distintos, então as duas linhagens convivem sem se
# mascarar na mesma tabela `_prisma_migrations`.
CATALOG_DATABASE_URL="postgresql://usuario:senha@seu-host:5432/dashbi_catalog?schema=public"

# ─── Autenticação (JWT) ───────────────────────────────────────
# Segredo usado para assinar os tokens de sessão. Gere com:
#   openssl rand -base64 32
# Se não definido, cai num fallback derivado do DATABASE_URL (inseguro em prod).
AUTH_SECRET="troque-por-um-segredo-forte-de-32+-caracteres"

# ─── Criptografia de segredos no banco (senha SMTP, etc.) ─────
# Usada para criptografar a senha da conta de e-mail salva em Configurações > E-mail.
# Se não definida, cai no AUTH_SECRET (ou DATABASE_URL) — defina uma dedicada em prod.
SETTINGS_ENCRYPTION_KEY="troque-por-outro-segredo-forte-de-32+-caracteres"

# A conta SMTP em si (host, porta, usuário, senha, remetente) não é mais configurada
# por variável de ambiente — fica guardada (criptografada) no banco, editável pelo
# admin em Configurações > E-mail (SMTP) dentro do app.
