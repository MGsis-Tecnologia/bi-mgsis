# Configuração do agente de ingestão MGSIS Analytics
#
# Copie para /etc/mgsis-ingest.conf e ajuste. O arquivo é lido pelo bash, então
# use aspas em valor com espaço.
#
#   sudo install -m 640 -o root -g analytics mgsis-ingest.conf.exemplo /etc/mgsis-ingest.conf

# ─── Destino ─────────────────────────────────────────────────────────────────
API_URL="https://analytics.mgsis.com"

# Arquivo com o token de integração, e SÓ ele (64 caracteres hex).
# Gerado em: Master → Empresas → (a empresa) → token de integração.
# Aparece uma única vez; o servidor guarda apenas o hash.
#
#   printf '%s' 'COLE_O_TOKEN_AQUI' | sudo tee /etc/mgsis-token >/dev/null
#   sudo chmod 600 /etc/mgsis-token
#   sudo chown analytics:analytics /etc/mgsis-token
TOKEN_FILE="/etc/mgsis-token"

# ─── Origem: o Postgres do ERP ───────────────────────────────────────────────
#
# PGHOST VAZIO = socket local do Unix. É o recomendado, e por um motivo
# concreto: como o usuário do sistema se chama `analytics`, igual ao papel no
# Postgres, a autenticação `peer` (padrão do `local` no pg_hba.conf) reconhece
# um pelo outro e NÃO PEDE SENHA. Some o arquivo de senha, some o segredo.
#
# Confira que funciona antes de decidir:
#   sudo -u analytics psql -d erp_do_cliente -c 'SELECT current_user'
#
# Se der "peer authentication failed", o pg_hba.conf não usa peer no `local`.
# Aí volte para TCP com senha: PGHOST="localhost" e o .pgpass abaixo.
PGHOST=""
PGPORT="5432"
PGDATABASE="erp_do_cliente"
PGUSER="analytics"

# Só é necessário no modo TCP (PGHOST="localhost").
#
# Mesmo aí, deixe PGPASSWORD vazio e use um .pgpass modo 600: senha em variável
# de ambiente aparece para qualquer usuário da máquina em `ps e`.
#
#   echo 'localhost:5432:erp_do_cliente:analytics:SENHA' > /var/lib/analytics/.pgpass
#   chmod 600 /var/lib/analytics/.pgpass
#
# E aponte o caminho, porque o usuário é de serviço e não tem home:
#   export PGPASSFILE="/var/lib/analytics/.pgpass"
PGPASSWORD=""

# ─── Comportamento ───────────────────────────────────────────────────────────

# Tentativas por requisição em falha de rede ou erro 5xx. Erro 4xx não é
# repetido: é defeito do que foi enviado, e repetir daria o mesmo resultado.
TENTATIVAS=3

# Segundos por requisição. Um mês de vendas leva ~5 s; a foto de estoque, ~9 s.
# A folga existe para link ruim, não para consulta lenta.
TIMEOUT=600

# Enviar período com ZERO linhas é permitido pela API — e APAGA aquele período,
# porque a operação é "substitua o período por estas linhas". Por padrão o
# agente PULA períodos vazios: se a consulta ao ERP voltar vazia por defeito
# (view recriada, permissão revogada), enviar destruiria dado bom sem aviso.
#
# Só mude para "sim" quando a intenção for mesmo apagar um período.
PERMITIR_VAZIO="nao"

LOCK_FILE="/var/lock/mgsis-ingest.lock"
